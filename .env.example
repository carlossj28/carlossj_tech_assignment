# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# --- Database (Railway injects this in prod) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/sazon

# --- Recruiter auth ---
SESSION_SECRET=change-me
RECRUITER_DEMO_USER=demo
RECRUITER_DEMO_PASSWORD=change-me
COOKIE_SECURE=0   # set to 1 in production (HTTPS)

# --- Web → API (server-side proxy target) ---
API_URL=http://localhost:8000
